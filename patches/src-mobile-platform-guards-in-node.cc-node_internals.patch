From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gregor MacLennan <gmaclennan@awana.digital>
Date: Tue, 28 Jul 2026 19:20:27 +0000
Subject: [PATCH] src: mobile platform guards in node.cc / node_internals.h

TARGET_OS_IPHONE / __ANDROID__ guards in node.cc and node_internals.h
for process-level facilities mobile OSes forbid or lack (tty tcsetattr
teardown on iOS; NODE_IMPLEMENTS_POSIX_CREDENTIALS turned on for
Android API >= 21, which upstream leaves off).

Co-authored-by: Jaime Bernardo <jaime@janeasystems.com>
---
 src/node.cc                 | 3 +++
 src/node_internals.h        | 2 +-
 src/node_process_methods.cc | 9 +++++++++
 3 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/src/node.cc b/src/node.cc
index 163070b501..468b5d2c2c 100644
--- a/src/node.cc
+++ b/src/node.cc
@@ -706,6 +706,8 @@ void ResetStdio() {
       CHECK_NE(err, -1);
     }
 
+#if !(defined(__APPLE__) && TARGET_OS_IPHONE)
+    // tcsetattr is not working on iOS devices.
     if (s.isatty) {
       sigset_t sa;
       int err;
@@ -727,6 +729,7 @@ void ResetStdio() {
       // - if the process group is orphaned, e.g. because the user logged out,
       //   tcsetattr fails with EIO
     }
+#endif  // !(defined(__APPLE__) && TARGET_OS_IPHONE)
   }
 #endif  // __POSIX__
 }
diff --git a/src/node_internals.h b/src/node_internals.h
index bb45d73e90..3d6deb6625 100644
--- a/src/node_internals.h
+++ b/src/node_internals.h
@@ -327,7 +327,7 @@ class ThreadPoolWork {
 
 // Functions defined in node.cc that are exposed via the bootstrapper object
 
-#if defined(__POSIX__) && !defined(__ANDROID__) && !defined(__CloudABI__)
+#if defined(__POSIX__) && !(defined(__ANDROID__) && __ANDROID_API__ < 21) && !defined(__CloudABI__)  // NOLINT(whitespace/line_length)
 #define NODE_IMPLEMENTS_POSIX_CREDENTIALS 1
 #endif  // defined(__POSIX__) && !defined(__ANDROID__) && !defined(__CloudABI__)
 
diff --git a/src/node_process_methods.cc b/src/node_process_methods.cc
index 6a35e5c5e4..e691187945 100644
--- a/src/node_process_methods.cc
+++ b/src/node_process_methods.cc
@@ -1,3 +1,6 @@
+#ifdef __APPLE__
+#include <TargetConditionals.h>
+#endif
 #include "async_wrap-inl.h"
 #include "base_object-inl.h"
 #include "debug_utils-inl.h"
@@ -604,7 +607,13 @@ static void Execve(const FunctionCallbackInfo<Value>& args) {
   // any in-memory side effects of AtExit callbacks are lost anyway. On
   // failure we want to leave the environment intact so the thrown exception
   // can be observed and handled by JS code.
+#if defined(__APPLE__) && TARGET_OS_TV
+  // nodejs-mobile: the tvOS SDK marks execve(2) unavailable; an app can't
+  // replace its own image there.
+  errno = ENOTSUP;
+#else
   execve(*executable, argv.data(), envp.data());
+#endif
 
   // If execve returned, it failed. Restore the FD_CLOEXEC flags we cleared
   // above so that a failed call leaves no observable side effects, then
